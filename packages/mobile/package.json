{
  "name": "@thymeapp/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "i18n:extract": "lingui extract --overwrite --clean",
    "i18n:check": "lingui extract --overwrite --clean && git diff --exit-code -- packages/mobile/src/locales",
    "precheck": "bun run type-check && bun run lint && bun run i18n:check",
    "smoke": "expo export --platform ios --output-dir /tmp/thymeapp-mobile-export",
    "drizzle:generate": "bunx drizzle-kit generate"
  },
  "dependencies": {
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@thymeapp/components": "workspace:*",
    "@thymeapp/logging": "workspace:*",
    "@thymeapp/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.15",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.12",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/metro-transformer": "^6.6.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  }
}
