{
  "name": "@thymeapp/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --device --configuration Release --no-bundler",
    "android": "expo run:android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "i18n:extract": "lingui extract --overwrite --clean",
    "i18n:check": "lingui extract --overwrite --clean && git diff --exit-code -- packages/mobile/src/locales",
    "precheck": "bun run type-check && bun run lint && bun run i18n:check",
    "smoke": "expo export --platform ios --output-dir /tmp/thymeapp-mobile-export",
    "drizzle:generate": "bunx drizzle-kit generate"
  },
  "dependencies": {
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@thymeapp/components": "workspace:*",
    "@thymeapp/logging": "workspace:*",
    "@thymeapp/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/metro-transformer": "^6.12.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
