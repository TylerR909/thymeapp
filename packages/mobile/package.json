{
  "name": "@thymeapp/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --preset jest-expo",
    "precheck": "bun run type-check && bun run lint",
    "smoke": "expo export --platform ios --output-dir /tmp/thymeapp-mobile-export",
    "drizzle:generate": "bunx drizzle-kit generate"
  },
  "dependencies": {
    "@thymeapp/components": "workspace:*",
    "@thymeapp/core": "workspace:*",
    "@thymeapp/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "expo": "^57.0.13",
    "expo-constants": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.10",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  }
}
