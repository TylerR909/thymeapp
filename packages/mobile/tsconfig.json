{
  "extends": ["expo/tsconfig.base", "../../tsconfig.json"],
  "compilerOptions": {
    "strict": true,
    "paths": {
      // Redeclaring because Metro/Expo isn't inheriting the root tsconfig. Periodically try deleting this and see if Expo Go can load the app without it?
      "@mobile/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["app-example/*"]
}
