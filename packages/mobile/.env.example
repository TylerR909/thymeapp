# Copy to .env.local. Only needed for a physical device (or Metro in Docker).
# Simulator on the Mac host can use localhost.
# Expo 57+ refuses personal host values in `.env` (use `.env.local`).
# App Store Expo Go is SDK 54; this app needs an SDK 57 Go (expo.dev/go / sign.expo.dev).
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.1
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
