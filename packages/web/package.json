{
  "name": "@thymeapp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "precheck": "bun run type-check && bun run lint",
    "smoke": "bun run build"
  },
  "dependencies": {
    "@thymeapp/logging": "workspace:*",
    "@thymeapp/types": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
