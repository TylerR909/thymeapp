{
  "name": "thymeapp-dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "oven.bun-vscode"
      ]
    }
  },
  "postCreateCommand": "npm i -g bun && bun install",
  "remoteUser": "node"
}