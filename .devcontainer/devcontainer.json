{
  "name": "thymeapp-dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached,readonly"
  ],
  "remoteEnv": {
    "PATH": "/home/node/.bun/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "oven.bun-vscode",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "forwardPorts": [8081, 5173, 3000],
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && bun install",
  "remoteUser": "node"
}
